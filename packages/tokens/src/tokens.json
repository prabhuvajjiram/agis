{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Angel Stones Interface Guidelines",
  "version": "0.1.0",
  "foundation": {
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem"
    },
    "radius": {
      "control": "0.5rem",
      "panel": "0.75rem",
      "pill": "9999px"
    },
    "control": {
      "height": "2.75rem",
      "heightCompact": "2.5rem",
      "borderWidth": "1px"
    },
    "font": {
      "sizeXs": "0.75rem",
      "sizeSm": "0.875rem",
      "sizeMd": "1rem",
      "lineTight": "1.25",
      "lineNormal": "1.5",
      "weightNormal": "400",
      "weightMedium": "500",
      "weightSemibold": "600"
    },
    "focus": {
      "width": "2px",
      "offset": "2px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "200ms"
    }
  },
  "themes": {
    "operations": {
      "background": "#edf4f8",
      "surface": "#ffffff",
      "surfaceMuted": "#e5eef4",
      "foreground": "#102538",
      "foregroundMuted": "#466176",
      "border": "#c6d7e2",
      "input": "#f5f9fb",
      "primary": "#1f5d98",
      "primaryHover": "#174b7d",
      "onPrimary": "#ffffff",
      "accent": "#78b9e7",
      "onAccent": "#102538",
      "focus": "#1f5d98",
      "success": "#15803d",
      "warning": "#b45309",
      "danger": "#b91c1c",
      "info": "#0369a1"
    },
    "operations-dark": {
      "background": "#122332",
      "surface": "#183247",
      "surfaceMuted": "#19364b",
      "foreground": "#f0f7fb",
      "foregroundMuted": "#b5c9d7",
      "border": "#4e728b",
      "input": "#183247",
      "primary": "#78b9e7",
      "primaryHover": "#9ccced",
      "onPrimary": "#102538",
      "accent": "#35546a",
      "onAccent": "#f0f7fb",
      "focus": "#9ccced",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "danger": "#f87171",
      "info": "#7dd3fc"
    },
    "cad": {
      "background": "#faf7f2",
      "surface": "#ffffff",
      "surfaceMuted": "#f1f4f7",
      "foreground": "#0f172a",
      "foregroundMuted": "#475569",
      "border": "#cbd5e1",
      "input": "#ffffff",
      "primary": "#0f7775",
      "primaryHover": "#0d6362",
      "onPrimary": "#ffffff",
      "accent": "#d27a1e",
      "onAccent": "#0f172a",
      "focus": "#0f7775",
      "success": "#15803d",
      "warning": "#b45309",
      "danger": "#b91c1c",
      "info": "#0369a1"
    },
    "marketing": {
      "background": "#101010",
      "surface": "#1a1b1d",
      "surfaceMuted": "#232426",
      "foreground": "#f5f5f5",
      "foregroundMuted": "#b8b8b8",
      "border": "#515151",
      "input": "#1f2022",
      "primary": "#d6b772",
      "primaryHover": "#ead7a6",
      "onPrimary": "#101010",
      "accent": "#ead7a6",
      "onAccent": "#101010",
      "focus": "#ead7a6",
      "success": "#86efac",
      "warning": "#fcd34d",
      "danger": "#fca5a5",
      "info": "#7dd3fc"
    }
  }
}
