{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "asig-starter": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "outputPath": "dist/asig-starter"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "asig-starter:build"
          }
        }
      }
    }
  }
}
