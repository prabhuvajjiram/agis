{
  "name": "Angel Stones Interface Guidelines",
  "version": "0.7.0",
  "foundation": {
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem"
    },
    "radius": {
      "control": "0.5rem",
      "panel": "0.75rem",
      "pill": "9999px"
    },
    "control": {
      "height": "2.75rem",
      "heightCompact": "2.25rem",
      "hitTarget": "2.75rem",
      "borderWidth": "1px",
      "iconSize": "1rem"
    },
    "choice": {
      "size": "1.375rem",
      "switchWidth": "3rem",
      "switchHeight": "1.75rem"
    },
    "font": {
      "sizeXs": "0.75rem",
      "sizeSm": "0.875rem",
      "sizeMd": "1rem",
      "sizeLg": "1.125rem",
      "sizeXl": "1.5rem",
      "size2xl": "2rem",
      "lineTight": "1.25",
      "lineNormal": "1.5",
      "weightNormal": "400",
      "weightMedium": "500",
      "weightSemibold": "600",
      "weightBold": "700"
    },
    "focus": {
      "width": "2px",
      "offset": "2px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "effect": {
      "glassBlur": "18px",
      "glassSaturation": "145%",
      "actionGloss": "0.08",
      "destructiveActionGloss": "0.14",
      "destructiveActionHoverGloss": "0.16"
    },
    "elevation": {
      "raised": "0 2px 8px rgb(15 23 42 / 0.12)",
      "lifted": "0 2px 4px rgb(15 23 42 / 0.08), 0 12px 28px rgb(15 23 42 / 0.14)",
      "floating": "0 4px 10px rgb(15 23 42 / 0.1), 0 24px 56px rgb(15 23 42 / 0.2)",
      "popup": "0 12px 32px rgb(15 23 42 / 0.2)",
      "dialog": "0 24px 64px rgb(15 23 42 / 0.28)"
    },
    "layer": {
      "sticky": "900",
      "dropdown": "1000",
      "tooltip": "1050",
      "dialogOverlay": "1100",
      "dialog": "1110",
      "toast": "1200"
    },
    "type": {
      "title": {
        "size": "var(--as-font-size-2xl)",
        "weight": "var(--as-font-weight-semibold)",
        "line": "var(--as-font-line-tight)"
      },
      "section": {
        "size": "var(--as-font-size-xl)",
        "weight": "var(--as-font-weight-semibold)",
        "line": "var(--as-font-line-tight)"
      },
      "body": {
        "size": "var(--as-font-size-md)",
        "weight": "var(--as-font-weight-normal)",
        "line": "var(--as-font-line-normal)"
      },
      "label": {
        "size": "var(--as-font-size-sm)",
        "weight": "var(--as-font-weight-medium)",
        "line": "var(--as-font-line-normal)"
      },
      "caption": {
        "size": "var(--as-font-size-xs)",
        "weight": "var(--as-font-weight-normal)",
        "line": "var(--as-font-line-normal)"
      },
      "numeric": {
        "size": "var(--as-font-size-xl)",
        "weight": "var(--as-font-weight-semibold)",
        "line": "var(--as-font-line-tight)"
      }
    },
    "layout": {
      "workspaceMax": "90rem",
      "formMax": "48rem",
      "readingMax": "70ch",
      "sidebarWidth": "13rem",
      "asideWidth": "20rem",
      "gutter": "clamp(1rem, 2vw, 2rem)",
      "sectionGap": "1.5rem",
      "panelPadding": "1.5rem",
      "rowComfortable": "0.875rem",
      "rowCompact": "0.5rem"
    },
    "pageType": {
      "pageTitle": {
        "size": "2rem",
        "weight": "600",
        "line": "1.2",
        "tracking": "-0.02em"
      },
      "pageSubtitle": {
        "size": "1rem",
        "weight": "400",
        "line": "1.5",
        "tracking": "0"
      },
      "sectionTitle": {
        "size": "1.125rem",
        "weight": "600",
        "line": "1.4",
        "tracking": "-0.01em"
      },
      "cardTitle": {
        "size": "1rem",
        "weight": "600",
        "line": "1.5",
        "tracking": "0"
      },
      "body": {
        "size": "1rem",
        "weight": "400",
        "line": "1.5",
        "tracking": "0"
      },
      "label": {
        "size": "0.875rem",
        "weight": "500",
        "line": "1.5",
        "tracking": "0"
      },
      "table": {
        "size": "0.875rem",
        "weight": "400",
        "line": "1.5",
        "tracking": "0"
      },
      "help": {
        "size": "0.875rem",
        "weight": "400",
        "line": "1.5",
        "tracking": "0"
      },
      "caption": {
        "size": "0.75rem",
        "weight": "400",
        "line": "1.5",
        "tracking": "0"
      },
      "metric": {
        "size": "1.75rem",
        "weight": "600",
        "line": "1.2",
        "tracking": "-0.02em"
      },
      "identifier": {
        "size": "0.875rem",
        "weight": "600",
        "line": "1.5",
        "tracking": "0"
      }
    }
  },
